# Identity of the open mobility network (NOT of Sitwego — spec §3).
# Copy to network.env and edit before running bootstrap.sh.

# Short network name; becomes the gateway network file name and
# `in.succinct.onet.name`.
NETWORK_NAME=safiri

# Public base URLs of the two services. They must be reachable FROM INSIDE
# the containers too (the gateway calls the registry at REGISTRY_PUBLIC_URL),
# so plain localhost breaks: for local dev keep the host.docker.internal
# defaults (compose maps it to the host; from the host itself use
# localhost:3030/:4030). In production these are the Traefik-terminated
# hostnames, e.g.
#   REGISTRY_PUBLIC_URL=https://registry.safiri.network
#   GATEWAY_PUBLIC_URL=https://gateway.safiri.network
REGISTRY_PUBLIC_URL=http://host.docker.internal:3030
GATEWAY_PUBLIC_URL=http://host.docker.internal:4030

# Gateway's own subscriber id in the registry.
GATEWAY_SUBSCRIBER_ID=gateway.safiri.network

# Space-separated Beckn domains participants may register under (seeded
# into the registry's network_domains table by bootstrap.sh). Must include
# the BPP adapter's BECKN_DOMAIN.
NETWORK_DOMAINS=mobility

# ISO country codes for the network's home market.
COUNTRY_ISO3=KEN
COUNTRY_ISO2=KE
